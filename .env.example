# Path of the SQLite database file (use a mounted volume in containers)
TRAKKO_DB_PATH=data/trakko.db

# Secret used to sign session cookies. Set a long random value in production:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random key is generated at every start and everyone is signed out on restart.
TRAKKO_SECRET_KEY=

# Whether new accounts can be created. Set to false once your users have registered.
# (Registration is always possible while no account exists yet.)
TRAKKO_ALLOW_REGISTRATION=true
